# Supabase — DriveData Academy
# Copie para .env.local e preencha. NÃO comite .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# SECRETO — só no servidor. Configure também nas Environment Variables do Vercel.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# E-mails com acesso ao portal /admin (separados por vírgula)
ADMIN_EMAILS=email@dominio.com

# URL pública do site (links de e-mail e webhook). Sem isso, usa academy.drivedata.com.br
NEXT_PUBLIC_SITE_URL=https://academy.drivedata.com.br

# Groq (GroqCloud) — IA de suporte/triagem. Sem isso, o chamado fica direto para o time.
GROQ_API_KEY=gsk_xxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# Resend — envio de e-mail dos materiais (opcional; sem isso, entrega só por download na página)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=DriveData Academy <materiais@drivedata.com.br>

# Panda Video — hospedagem de aulas (embutido no player interno)
# O host do player é tipo player-vz-xxxx.tv.pandavideo.com.br (Panda > Configurações)
NEXT_PUBLIC_PANDA_PLAYER_HOST=
PANDA_API_KEY=

# Asaas — gateway de pagamento (acesso full por turma)
# ASAAS_API_KEY: chave de API da conta (produção ou sandbox)
# ASAAS_WEBHOOK_TOKEN: token que você define no webhook do Asaas e confere aqui
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
